# Supabase PostgreSQL接続文字列
# Settings > Infrastructure > Connection string (URI形式) からコピー
SUPABASE_DB_URL=postgresql://postgres:[YOUR_PASSWORD]@[YOUR_HOST]:5432/postgres

# Resend APIキー
RESEND_API_KEY=re_xxxxxxxxxxxx

# 注文通知を受け取るメールアドレス（自分のアドレス）
NOTIFY_EMAIL=your@email.com

# サーバーポート（Railwayが自動設定するので通常は不要）
PORT=8080
